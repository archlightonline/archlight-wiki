# Copy to .env and fill in. NEVER commit a real .env (see .gitignore / AUDIT §5).

# --- Database -------------------------------------------------------------
# Leave DATABASE_URL UNSET for local dev/test: the app uses an embedded PGlite
# database (real PostgreSQL compiled to WASM) stored under .pglite/.
# Set it to any Postgres connection string for production (Manus / self-hosted)
# — the schema and queries are standard pg-core, so there is no lock-in.
# DATABASE_URL=postgres://user:password@host:5432/archlight

# Where the PGlite data dir lives when DATABASE_URL is unset.
PGLITE_DIR=.pglite

# --- Auth / sessions ------------------------------------------------------
# RECOMMENDED (and stable) for production. Used to HMAC-sign HttpOnly session
# cookies. Set it ONCE and keep it constant — changing it invalidates all
# existing sessions (logs everyone out).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If UNSET, the app now safely generates a secret ONCE and persists it in the
# database (app_config), so it stays stable across restarts/redeploys and does
# NOT log users out on every deploy. Setting it explicitly is still recommended
# for production (e.g. to rotate on your own terms or share across instances).
SESSION_SECRET=

# --- Server ---------------------------------------------------------------
PORT=3001
NODE_ENV=development

# Absolute public origin (no trailing slash), used to build canonical og:url /
# og:image in the per-page social-preview meta tags. RECOMMENDED for production
# (each fork sets its own). If unset, the origin is derived from the request
# (protocol + host) via Express "trust proxy" — correct behind Railway's proxy.
# PUBLIC_BASE_URL=https://wiki.yourfork.com

# --- Image uploads (Cloudflare R2, S3-compatible) -------------------------
# Used by server/lib/storage.ts to mint short-lived presigned PUT URLs so the
# browser uploads images directly to R2. All five are REQUIRED to enable uploads;
# if any is unset, the upload endpoint returns an error and the app still runs.
# NEVER commit real values — these are placeholders.
# Cloudflare account id (the R2 S3 endpoint is https://<id>.r2.cloudflarestorage.com).
R2_ACCOUNT_ID=your-cloudflare-account-id
# R2 API token credentials (Object Read & Write) for the bucket.
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# The R2 bucket name images are stored in.
R2_BUCKET=archlight-uploads
# Public base URL the bucket is served from (no trailing slash). Either the R2.dev
# public bucket URL or a custom domain mapped to the bucket.
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev
